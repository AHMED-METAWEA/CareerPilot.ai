# ── Database ──────────────────────────────────────────────────────────
# Port 5433: infra/docker-compose.yml publishes there, because 5432 is usually
# taken by a local PostgreSQL install.
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@localhost:5433/careerpilot

# ── Runtime ───────────────────────────────────────────────────────────
CAREERPILOT_ENV=local           # local | staging | production
LOG_LEVEL=INFO
CONFIG_PATH=config/config.yaml

# ── Admin surface (real auth arrives in Phase 3) ───────────────────────
ADMIN_TOKEN=change-me-in-production

# ── Inference (Phase 1 — unused by the data spine) ────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Tier 2 aggregator keys (not yet implemented) ──────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# ── Tests ─────────────────────────────────────────────────────────────
# Created automatically by the test suite; skipped if unreachable.
CAREERPILOT_TEST_DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@localhost:5433/careerpilot_test
