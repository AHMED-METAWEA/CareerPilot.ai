# Worker image: scheduler plus queue consumers. Shares the model-weights volume
# with the API so weights are downloaded once and loaded per process (§15.2).

FROM python:3.12-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml ./
COPY backend/app ./app
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install .

FROM python:3.12-slim AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/models

RUN useradd --create-home --uid 10001 careerpilot && mkdir -p /models && chown careerpilot /models

COPY --from=builder /opt/venv /opt/venv
WORKDIR /app
COPY backend/app ./app
COPY backend/config ./config
COPY backend/alembic.ini ./alembic.ini

USER careerpilot

# SIGTERM stops the scheduler and drains in-flight tasks; unfinished claims are
# reclaimed by `reap_stale` rather than lost.
STOPSIGNAL SIGTERM
CMD ["python", "-m", "app.workers.runner"]
